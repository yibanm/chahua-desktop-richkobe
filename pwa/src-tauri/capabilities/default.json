{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "茶话 Tauri 客户端权限：核心 + 官方 HTTP 插件（限定官方 API 域）+ 窗口状态。登录态读取走 Rust 侧只读文件扫描，无需额外权限。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "window-state:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://chahui.app/*" },
        { "url": "https://chahua.app/*" }
      ]
    }
  ]
}
