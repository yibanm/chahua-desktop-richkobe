{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "茶话",
  "version": "1.1.0",
  "identifier": "com.richkobe.chahuatauri",
  "build": {
    "frontendDist": "../dist/tauri/browser",
    "devUrl": "http://127.0.0.1:4200",
    "beforeDevCommand": "npm run serve:tauri",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "茶话",
        "width": 960,
        "height": 780,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0d0d0d",
        "additionalBrowserArgs": "--no-proxy-server"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
